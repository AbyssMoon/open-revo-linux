Включить для MECHREVO WUJIE 15X (плата WUJIE15-GX5HRXG) то же, что для
TUXEDO InfinityBook Pro Gen9 AMD (GXxHRXx): три режима производительности
(uniwill_profile_v1_three_profs), «custom profile mode», USB powershare и
автозагрузку от сети. Это одна и та же платформа TongFang, но в DMI у
MECHREVO своё имя платы, а драйвер сравнивает его целиком (dmi_match).

Проверено: режимы 1/2/3 дают PL1 25/45/65 Вт под stress-ng от сети.

--- a/src/uniwill_keyboard.h
+++ b/src/uniwill_keyboard.h
@@ -963,6 +963,7 @@
 		  // IBP Gen9
 		  dmi_match(DMI_BOARD_NAME, "GXxMRXx") ||
 		  dmi_match(DMI_BOARD_NAME, "GXxHRXx") ||
+		  dmi_match(DMI_BOARD_NAME, "WUJIE15-GX5HRXG") ||
 		  // IBP Gen10
 		  dmi_match(DMI_BOARD_NAME, "XxHP4NAx") ||
 		  dmi_match(DMI_BOARD_NAME, "XxKK4NAx_XxSP4NAx") ||
@@ -1726,6 +1727,7 @@
 		|| dmi_match(DMI_BOARD_NAME, "POLARIS1701I2060")
 		|| dmi_match(DMI_BOARD_NAME, "GXxMRXx")
 		|| dmi_match(DMI_BOARD_NAME, "GXxHRXx")
+		|| dmi_match(DMI_BOARD_NAME, "WUJIE15-GX5HRXG")
 		|| dmi_match(DMI_BOARD_NAME, "XxHP4NAx")
 		|| dmi_match(DMI_BOARD_NAME, "XxKK4NAx_XxSP4NAx")
 		|| dmi_match(DMI_BOARD_NAME, "XxAR4NAx")
@@ -1761,6 +1763,7 @@
 		|| dmi_match(DMI_PRODUCT_SKU, "STELLSL15A06")
 		|| dmi_match(DMI_BOARD_NAME, "GXxMRXx")
 		|| dmi_match(DMI_BOARD_NAME, "GXxHRXx")
+		|| dmi_match(DMI_BOARD_NAME, "WUJIE15-GX5HRXG")
 		|| dmi_match(DMI_BOARD_NAME, "XxHP4NAx")
 		|| dmi_match(DMI_BOARD_NAME, "XxKK4NAx_XxSP4NAx")
 		|| dmi_match(DMI_BOARD_NAME, "X5KK45xS_X5SP45xS")
